# 依赖
node_modules/

# 构建产物
out/
dist/

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 按键方案（运行时生成，存于安装目录 keymaps/ 或 userData）
keymaps/

# 用户脚本（运行时生成于安装目录 scripts/ 或 userData；游戏自动化脚本属于个人使用，不进版本库）
# 只锚定仓库根目录，不影响 .github/scripts/ 下的 CI 脚本
/scripts/

# AI 生图原始带水印产物（ImageGen 输出，处理后用 icon.png）
resources/App_icon_*.png

# 图标修改前的备份（带时间戳，仅本地回滚用）
resources/_icon_backup_*/

# 本地临时脚本/试验产物（CI 校验脚本等，不进版本库）
.tmp/

# OCR 模型（约 16MB 二进制，不进 git；源在 ModelScope RapidOCR，发布资产在 GitHub Release ocr-models-v1）
# 上传/校验工具：.tmp/upload-ocr-release.cjs；模型溯源见 resources/ocr/README.md
resources/ocr/*.onnx
resources/ocr/*.txt

# 运行时模型目录（resolveOcrModelDir 在开发态落在项目根，打包态落在安装目录）
/ocr-models/
